# Apify API Token (https://console.apify.com/account/integrations)
VITE_APIFY_API_TOKEN=

# Outscraper API Key — 500 ücretsiz işletme/ay (https://app.outscraper.com/profile)
VITE_OUTSCRAPER_API_KEY=

# SerpAPI Key — 250 ücretsiz arama/ay (https://serpapi.com/manage-api-key)
# GitHub Actions veya lokal Vite proxy ile kullanılır
SERPAPI_API_KEY=

# Panel ekip giriş şifresi (varsayılan: 2026)
VITE_PANEL_PIN=2026
